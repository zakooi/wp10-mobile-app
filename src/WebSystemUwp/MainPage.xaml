<Page
    x:Class="WebSystemUwp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="16,16,16,8">
            <TextBlock Text="UWP WEB + SYSTEM"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Windows 10 Mobile" />
        </StackPanel>

        <!-- Pivot -->
        <Pivot Grid.Row="1" Title="Chức năng">

            <!-- ===================== Tab WEB ===================== -->
            <PivotItem Header="Web">
                <ScrollViewer>
                    <StackPanel Margin="16,8,16,16" Spacing="8">
                        <TextBlock Text="Nhập URL (HTTPS/HTTP)" />
                        <TextBox x:Name="UrlTextBox"
                                 Text="https://example.com"
                                 InputScope="Url"
                                 TextWrapping="Wrap" />
                        <Button x:Name="FetchButton"
                                Content="Tải nội dung"
                                Click="FetchButton_Click" />
                        <ProgressRing x:Name="FetchProgress"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                        <TextBlock x:Name="WebStatusText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                        <TextBlock Text="Nội dung trả về:" Margin="0,8,0,0" />
                        <TextBox x:Name="WebResultBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="320" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ===================== Tab HỆ THỐNG ===================== -->
            <PivotItem Header="Hệ thống">
                <ScrollViewer>
                    <StackPanel Margin="16,8,16,16" Spacing="8">
                        <TextBlock Text="Thông tin thiết bị (không cần quyền cao)" />
                        <TextBox x:Name="DeviceInfoBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinHeight="140" />
                        <Button x:Name="LoadDeviceInfoButton"
                                Content="Đọc thông tin thiết bị"
                                Click="LoadDeviceInfoButton_Click" />

                        <TextBlock Text="Can thiệp hệ thống (registry / FullTrust)" Margin="0,12,0,0" />
                        <Button x:Name="SystemAccessButton"
                                Content="Kiểm tra quyền hệ thống"
                                Click="SystemAccessButton_Click" />
                        <TextBlock x:Name="SystemStatusText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                        <TextBox x:Name="RegistryResultBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="180" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

        </Pivot>
    </Grid>

</Page>
