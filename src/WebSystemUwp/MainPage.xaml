<Page
    x:Class="WebSystemUwp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <!-- 1. Top Omnibox Toolbar (Compact full-width for Lumia 920) -->
            <RowDefinition Height="Auto" />
            <!-- 2. Find in Page Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 3. Progress Bar -->
            <RowDefinition Height="Auto" />
            <!-- 4. Main Viewport & Overlays -->
            <RowDefinition Height="*" />
            <!-- 5. Bottom Navigation Bar (Auto-Hide) -->
            <RowDefinition x:Name="BottomNavRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. CHROME OMNIBOX TOOLBAR ==================== -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="6,6,6,6" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Omnibox Pill (Takes maximum width) -->
                    <ColumnDefinition Width="*" />
                    <!-- Tab Button [ 1 ] -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Menu Button [ ⋮ ] -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Chrome Omnibox (Rounded Pill Shape, Height 40) -->
                <Border x:Name="OmniboxBorder" Grid.Column="0" Background="#2A2A2A" CornerRadius="20" Height="40" Padding="10,0,4,0" Margin="0,0,6,0" BorderBrush="#3A3A3A" BorderThickness="1">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Padlock Icon -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Address Input Box -->
                            <ColumnDefinition Width="*" />
                            <!-- Clear Button -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Bookmark Star Button -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Go Action Button -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Padlock Icon 🔒 -->
                        <TextBlock x:Name="OmniLockIcon" Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#8AB4F8" VerticalAlignment="Center" Margin="0,0,6,0" />

                        <!-- Address Input Box -->
                        <TextBox x:Name="OmniUrlBox" Grid.Column="1" Text="https://www.google.com" InputScope="Url" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center" Padding="0,2,0,2" KeyDown="OmniUrlBox_KeyDown" TextChanged="OmniUrlBox_TextChanged" GotFocus="OmniUrlBox_GotFocus" LostFocus="OmniUrlBox_LostFocus" />

                        <!-- Clear Button ✕ -->
                        <Button x:Name="OmniClearButton" Grid.Column="2" Click="OmniClearButton_Click" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                            <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9E9E9E" />
                        </Button>

                        <!-- Bookmark Star Button ★ -->
                        <Button x:Name="OmniBookmarkButton" Grid.Column="3" Click="OmniBookmarkButton_Click" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Margin="1,0,1,0">
                            <TextBlock x:Name="OmniBookmarkStar" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9E9E9E" />
                        </Button>

                        <!-- Go Action Button ➔ -->
                        <Button x:Name="OmniGoButton" Grid.Column="4" Click="OmniGoButton_Click" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="&#xE111;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8AB4F8" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Tab Switcher Button [ 1 ] (Touch-target 40x40) -->
                <Button x:Name="OmniTabButton" Grid.Column="1" Click="OmniTabButton_Click" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,4,0">
                    <Border BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="4" Width="24" Height="24">
                        <TextBlock x:Name="OmniTabCountText" Text="1" FontSize="12" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <!-- Chrome Menu Button [ ⋮ ] (Touch-target 40x40) -->
                <Button x:Name="OmniMenuButton" Grid.Column="2" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="&#xE10C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#E0E0E0" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="➕ Tab Mới" Click="NewTab_Click" />
                            <MenuFlyoutItem Text="📑 Dấu Trang (Bookmarks)" Click="OpenBookmarks_Click" />
                            <MenuFlyoutItem Text="🕐 Lịch Sử Duyệt Web" Click="OpenHistory_Click" />
                            <MenuFlyoutItem Text="💾 Trang Đọc Ngoại Tuyến (Offline)" Click="OpenOfflinePages_Click" />
                            <MenuFlyoutItem Text="💾 Lưu Trang Này Để Đọc Offline" Click="SaveCurrentPageOffline_Click" />
                            <MenuFlyoutItem Text="🔍 Tìm Trong Trang" Click="OpenFindInPage_Click" />
                            <MenuFlyoutItem Text="📖 Chế Độ Đọc Báo (Reader)" Click="ToggleReaderMode_Click" />
                            <MenuFlyoutItem Text="📤 Chia Sẻ Trang Web" Click="ShareCurrentPage_Click" />
                            <MenuFlyoutItem Text="📋 Sao Chép Liên Kết" Click="CopyCurrentUrl_Click" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="MenuToggleAdBlock" Text="🛡️ Chặn quảng cáo (Turbo)" IsChecked="true" Click="MenuToggleAdBlock_Click" />
                            <ToggleMenuFlyoutItem x:Name="MenuTogglePolyfills" Text="💉 Tiêm JS Polyfills ES6+" IsChecked="true" Click="MenuTogglePolyfills_Click" />
                            <ToggleMenuFlyoutItem x:Name="MenuToggleImgBlock" Text="🖼️ Chặn hình ảnh (Tiết kiệm Data)" IsChecked="false" Click="MenuToggleImgBlock_Click" />
                            <ToggleMenuFlyoutItem x:Name="MenuToggleDarkMode" Text="🌙 Chế độ Nền tối (Dark)" IsChecked="false" Click="MenuToggleDarkMode_Click" />
                            <ToggleMenuFlyoutItem x:Name="MenuToggleDesktop" Text="🖥️ Trang web cho máy tính" IsChecked="false" Click="MenuToggleDesktop_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="🎭 Đổi User-Agent">
                                <MenuFlyoutItem Text="Chrome Mobile 125 (Android 14)" Click="SetUserAgent_Click" Tag="ChromeMobile" />
                                <MenuFlyoutItem Text="Firefox Mobile 128" Click="SetUserAgent_Click" Tag="FirefoxMobile" />
                                <MenuFlyoutItem Text="Safari iOS 17" Click="SetUserAgent_Click" Tag="SafariIos" />
                                <MenuFlyoutItem Text="Chrome Desktop (Win 10)" Click="SetUserAgent_Click" Tag="ChromeDesktop" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="🔠 Thu Phóng / Cỡ Chữ (Zoom)">
                                <MenuFlyoutItem Text="80% (Nhỏ)" Click="SetZoom_Click" Tag="80" />
                                <MenuFlyoutItem Text="100% (Mặc định)" Click="SetZoom_Click" Tag="100" />
                                <MenuFlyoutItem Text="125% (Lớn)" Click="SetZoom_Click" Tag="125" />
                                <MenuFlyoutItem Text="150% (Rất lớn)" Click="SetZoom_Click" Tag="150" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="⚙️ Cài Đặt (Settings)" Click="OpenSettings_Click" />
                            <MenuFlyoutItem Text="⚡ Web Engine &amp; Chẩn Đoán" Click="OpenToolsDialog_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== 2. FIND IN PAGE TOOLBAR ==================== -->
        <Border x:Name="FindInPageBar" Grid.Row="1" Background="#242424" Padding="8,6,8,6" BorderBrush="#383838" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="FindInputBox" Grid.Column="0" PlaceholderText="Tìm trong trang..." Background="#1A1A1A" Foreground="#FFFFFF" BorderThickness="0" FontSize="13" KeyDown="FindInputBox_KeyDown" TextChanged="FindInputBox_TextChanged" Margin="0,0,6,0" />
                <TextBlock x:Name="FindCountText" Grid.Column="1" Text="0/0" VerticalAlignment="Center" Foreground="#9E9E9E" FontSize="12" Margin="0,0,6,0" />
                <Button Grid.Column="2" Click="FindPrev_Click" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,2,0">
                    <TextBlock Text="&#xE110;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#E0E0E0" />
                </Button>
                <Button Grid.Column="3" Click="FindNext_Click" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,2,0">
                    <TextBlock Text="&#xE1FD;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#E0E0E0" />
                </Button>
                <Button Grid.Column="4" Click="CloseFindInPage_Click" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9E9E9E" />
                </Button>
            </Grid>
        </Border>

        <!-- ==================== 3. LOADING PROGRESS BAR ==================== -->
        <ProgressBar x:Name="BrowserProgressBar" Grid.Row="2" Height="3" Foreground="#8AB4F8" Background="Transparent" IsIndeterminate="False" Visibility="Collapsed" />

        <!-- ==================== 4. MAIN VIEWPORT & OVERLAYS ==================== -->
        <Grid Grid.Row="3">

            <!-- New Tab Home View (Chrome Style Top Sites & Bookmarks) -->
            <ScrollViewer x:Name="NewTabHomeView" Padding="14,10,14,14" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                    <!-- Google Logo Header -->
                    <StackPanel Margin="0,10,0,16" HorizontalAlignment="Center">
                        <TextBlock Text="Google" FontWeight="Bold" FontSize="34" Foreground="#E0E0E0" HorizontalAlignment="Center" />
                        <TextBlock Text="WebSystem Chrome v3.1 (Lumia Edition)" FontSize="11" Foreground="#8AB4F8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Center Search Box -->
                    <Border Background="#282828" CornerRadius="20" Padding="12,8,12,8" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="HomeSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" PlaceholderText="Tìm kiếm hoặc nhập URL" KeyDown="HomeSearchBox_KeyDown" />
                        </Grid>
                    </Border>

                    <!-- Top Sites Shortcuts Grid (4 columns x 110px) -->
                    <TextBlock Text="TRUY CẬP NHANH" FontSize="11" FontWeight="Bold" Foreground="#9E9E9E" Margin="2,0,0,8" />
                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="110" ItemHeight="88" HorizontalAlignment="Center">
                        <!-- Google -->
                        <Button Click="QuickShortcut_Click" Tag="https://www.google.com" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#EA4335" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="G" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Google" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- YouTube -->
                        <Button Click="QuickShortcut_Click" Tag="https://m.youtube.com" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#CC0000" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="YouTube" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Wikipedia -->
                        <Button Click="QuickShortcut_Click" Tag="https://vi.m.wikipedia.org" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#333333" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="W" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Wikipedia" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- GitHub -->
                        <Button Click="QuickShortcut_Click" Tag="https://github.com" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#24292E" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="🐙" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GitHub" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- VnExpress -->
                        <Button Click="QuickShortcut_Click" Tag="https://vnexpress.net" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#990000" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="V" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="VnExpress" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Dân Trí -->
                        <Button Click="QuickShortcut_Click" Tag="https://dantri.com.vn" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#007A3D" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="D" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Dân Trí" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Báo Mới -->
                        <Button Click="QuickShortcut_Click" Tag="https://baomoi.com" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#0080FF" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="B" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Báo Mới" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Bing -->
                        <Button Click="QuickShortcut_Click" Tag="https://www.bing.com" Background="Transparent" BorderThickness="0" Width="100" Height="82">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#008373" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock Text="b" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Bing" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </VariableSizedWrapGrid>

                    <!-- User Bookmarks Section on Home -->
                    <TextBlock Text="DẤU TRANG YÊU THÍCH" FontSize="11" FontWeight="Bold" Foreground="#9E9E9E" Margin="2,14,0,8" />
                    <ListView x:Name="HomeBookmarksListView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="HomeBookmarkItem_Click">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#222222" CornerRadius="8" Padding="12,8,12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding IconColor}" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding IconChar}" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#9E9E9E" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- Real WebView Browser Control -->
            <WebView x:Name="BrowserWebView"
                     NavigationStarting="BrowserWebView_NavigationStarting"
                     ContentLoading="BrowserWebView_ContentLoading"
                     DOMContentLoaded="BrowserWebView_DOMContentLoaded"
                     NavigationCompleted="BrowserWebView_NavigationCompleted"
                     NewWindowRequested="BrowserWebView_NewWindowRequested"
                     Tapped="BrowserWebView_Tapped" />

            <!-- ==================== FLOATING CHEVRON BUTTON (REVEAL BOTTOM BAR) ==================== -->
            <Button x:Name="FloatingRevealNavButton"
                    Click="FloatingRevealNavButton_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="44" Height="44"
                    Margin="0,0,12,12"
                    Padding="0"
                    Background="#B3202020"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock Text="&#xE010;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#8AB4F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- ==================== TAB SWITCHER OVERLAY ==================== -->
            <Grid x:Name="TabSwitcherOverlay" Background="#181818" Visibility="Collapsed" Padding="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Các Tab Đang Mở" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="➕ Mới" Click="NewTab_Click" Background="#8AB4F8" Foreground="#121212" FontWeight="Bold" Margin="0,0,6,0" />
                        <Button Content="Đóng" Click="CloseTabSwitcher_Click" Background="#333333" Foreground="#FFFFFF" />
                    </StackPanel>
                </Grid>

                <ListView x:Name="TabListView" Grid.Row="1" SelectionChanged="TabListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#222222" CornerRadius="8" Margin="0,0,0,8" Padding="12,10,12,10" BorderBrush="#383838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#9E9E9E" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="CloseTabButton_Click" Tag="{Binding Id}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9E9E9E" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ==================== BOOKMARKS OVERLAY ==================== -->
            <Grid x:Name="BookmarksOverlay" Background="#181818" Visibility="Collapsed" Padding="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="📑 Dấu Trang Đã Lưu" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Button Content="Đóng" Click="CloseBookmarks_Click" HorizontalAlignment="Right" Background="#333333" Foreground="#FFFFFF" />
                </Grid>

                <ListView x:Name="BookmarksListView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="BookmarkItem_Click">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#222222" CornerRadius="8" Margin="0,0,0,8" Padding="12,8,12,8" BorderBrush="#383838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding IconColor}" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding IconChar}" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#9E9E9E" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="DeleteBookmarkButton_Click" Tag="{Binding Id}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9E9E9E" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ==================== HISTORY OVERLAY ==================== -->
            <Grid x:Name="HistoryOverlay" Background="#181818" Visibility="Collapsed" Padding="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="🕐 Lịch Sử Duyệt Web" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Xóa Hết" Click="ClearHistory_Click" Background="#C62828" Foreground="#FFFFFF" Margin="0,0,6,0" />
                        <Button Content="Đóng" Click="CloseHistory_Click" Background="#333333" Foreground="#FFFFFF" />
                    </StackPanel>
                </Grid>

                <ListView x:Name="HistoryListView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="HistoryItem_Click">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#222222" CornerRadius="8" Margin="0,0,0,8" Padding="12,8,12,8" BorderBrush="#383838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#9E9E9E" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#8AB4F8" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="DeleteHistoryItem_Click" Tag="{Binding Id}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9E9E9E" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ==================== OFFLINE PAGES OVERLAY ==================== -->
            <Grid x:Name="OfflineOverlay" Background="#181818" Visibility="Collapsed" Padding="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="💾 Trang Đã Lưu Ngoại Tuyến" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Button Content="Đóng" Click="CloseOfflinePages_Click" HorizontalAlignment="Right" Background="#333333" Foreground="#FFFFFF" />
                </Grid>

                <ListView x:Name="OfflinePagesListView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OfflinePageItem_Click">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#222222" CornerRadius="8" Margin="0,0,0,8" Padding="12,8,12,8" BorderBrush="#383838" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#9E9E9E" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding FormattedDate}" FontSize="10" Foreground="#8AB4F8" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#81C784" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="DeleteOfflinePage_Click" Tag="{Binding Id}" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9E9E9E" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ==================== SETTINGS OVERLAY ==================== -->
            <Grid x:Name="SettingsOverlay" Background="#E6000000" Visibility="Collapsed" Padding="14">
                <Border Background="#1C1C1C" CornerRadius="8" Padding="16" BorderBrush="#383838" BorderThickness="1" MaxWidth="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="⚙️ Cài Đặt (Settings)" FontWeight="Bold" FontSize="16" Foreground="#8AB4F8" VerticalAlignment="Center" />
                            <Button Content="✕" Click="CloseSettings_Click" HorizontalAlignment="Right" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" FontSize="14" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="0,4,0,4">
                            <StackPanel>
                                <!-- Search Engine -->
                                <TextBlock Text="Công cụ tìm kiếm mặc định:" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,4" />
                                <ComboBox x:Name="SettingsSearchCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12" SelectionChanged="SettingsSearchCombo_SelectionChanged">
                                    <ComboBoxItem Content="Google" />
                                    <ComboBoxItem Content="Bing" />
                                    <ComboBoxItem Content="DuckDuckGo" />
                                </ComboBox>

                                <!-- Auto-hide Nav -->
                                <ToggleSwitch x:Name="SettingsAutoHideToggle" Header="Tự động ẩn thanh điều hướng (Tiết kiệm màn hình Lumia)" IsOn="true" Toggled="SettingsAutoHideToggle_Toggled" Margin="0,0,0,8" />

                                <!-- Default AdBlock -->
                                <ToggleSwitch x:Name="SettingsAdBlockToggle" Header="Tự động chặn quảng cáo nặng" IsOn="true" Toggled="SettingsAdBlockToggle_Toggled" Margin="0,0,0,8" />

                                <!-- Default Polyfills -->
                                <ToggleSwitch x:Name="SettingsPolyfillsToggle" Header="Tự động tiêm ES6+ Polyfills" IsOn="true" Toggled="SettingsPolyfillsToggle_Toggled" Margin="0,0,0,8" />

                                <!-- Default Dark Mode -->
                                <ToggleSwitch x:Name="SettingsDarkModeToggle" Header="Mặc định chế độ AMOLED Dark Mode" IsOn="false" Toggled="SettingsDarkModeToggle_Toggled" Margin="0,0,0,12" />

                                <Button Content="🧹 Xóa Dữ Liệu Duyệt Web" Click="ClearAllBrowsingData_Click" HorizontalAlignment="Stretch" Background="#C62828" Foreground="White" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== TOOLS & SYSTEM INSPECTOR DIALOG ==================== -->
            <Grid x:Name="ToolsOverlay" Background="#E6000000" Visibility="Collapsed" Padding="14">
                <Border Background="#1C1C1C" CornerRadius="8" Padding="16" BorderBrush="#383838" BorderThickness="1" MaxWidth="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="⚡ Web Engine &amp; Chẩn Đoán" FontWeight="Bold" FontSize="16" Foreground="#8AB4F8" VerticalAlignment="Center" />
                            <Button Content="✕" Click="CloseToolsDialog_Click" HorizontalAlignment="Right" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" FontSize="14" />
                        </Grid>

                        <Pivot Grid.Row="1">
                            <PivotItem Header="Web Engine v2">
                                <ScrollViewer Padding="2,6,2,2">
                                    <StackPanel>
                                        <TextBlock Text="URL Yêu cầu:" FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ToolsMethodCombo" Grid.Column="0" SelectedIndex="0" Margin="0,0,6,0">
                                                <ComboBoxItem Content="GET" />
                                                <ComboBoxItem Content="POST" />
                                            </ComboBox>
                                            <TextBox x:Name="ToolsApiUrlBox" Grid.Column="1" Text="https://httpbin.org/get" Margin="0,0,6,0" />
                                            <Button Content="Gửi" Click="ToolsSendApi_Click" Background="#8AB4F8" Foreground="#121212" FontWeight="Bold" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="🌐 Test Ping Mạng" Click="ToolsTestPing_Click" Background="#2E2E2E" Margin="0,0,8,0" />
                                            <TextBlock x:Name="ToolsPingResultText" Text="" VerticalAlignment="Center" Foreground="#81C784" FontSize="12" />
                                        </StackPanel>

                                        <TextBlock x:Name="ToolsApiStatusText" Text="" FontWeight="SemiBold" Foreground="#8AB4F8" Margin="0,0,0,4" />
                                        <TextBox x:Name="ToolsApiResponseBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="200" FontFamily="Consolas, Courier New" FontSize="11" />
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>

                            <PivotItem Header="Chẩn đoán">
                                <ScrollViewer Padding="2,6,2,2">
                                    <StackPanel>
                                        <TextBox x:Name="ToolsDeviceInfoBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" Margin="0,0,0,8" />
                                        <TextBox x:Name="ToolsDiagnosticsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" />
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>
                        </Pivot>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 5. BOTTOM CHROME NAVIGATION BAR ==================== -->
        <Border x:Name="BottomNavBar" Grid.Row="4" Background="#1E1E1E" Padding="6,2,6,2" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Back -->
                <Button x:Name="BottomBackButton" Grid.Column="0" Click="OmniBackButton_Click" HorizontalAlignment="Stretch" Height="46" Padding="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="&#xE112;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#E0E0E0" HorizontalAlignment="Center" />
                </Button>

                <!-- Forward -->
                <Button x:Name="BottomForwardButton" Grid.Column="1" Click="OmniForwardButton_Click" HorizontalAlignment="Stretch" Height="46" Padding="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="&#xE111;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#E0E0E0" HorizontalAlignment="Center" />
                </Button>

                <!-- Home -->
                <Button x:Name="BottomHomeButton" Grid.Column="2" Click="OmniHomeButton_Click" HorizontalAlignment="Stretch" Height="46" Padding="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="&#xE10F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#E0E0E0" HorizontalAlignment="Center" />
                </Button>

                <!-- Bookmarks Quick Access -->
                <Button Grid.Column="3" Click="OpenBookmarks_Click" HorizontalAlignment="Stretch" Height="46" Padding="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#E0E0E0" HorizontalAlignment="Center" />
                </Button>

                <!-- Refresh / Stop -->
                <Button x:Name="BottomRefreshButton" Grid.Column="4" Click="OmniRefreshButton_Click" HorizontalAlignment="Stretch" Height="46" Padding="0" Background="Transparent" BorderThickness="0">
                    <TextBlock x:Name="BottomRefreshIcon" Text="&#xE149;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#E0E0E0" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
