<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>uap10.0.17763</TargetFramework>
    <TargetPlatformVersion>10.0.17763.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.14393.0</TargetPlatformMinVersion>
    <RootNamespace>WebSystemUwp</RootNamespace>
    <AssemblyName>WebSystemUwp</AssemblyName>
    <ApplicationManifest>Package.appxmanifest</ApplicationManifest>
    <Platforms>x86;x64;ARM;ARM64</Platforms>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bắt buộc cho UWP SDK-style: cung cấp Windows Runtime + .NET UWP projections. -->
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="6.2.14" />
  </ItemGroup>
</Project>
